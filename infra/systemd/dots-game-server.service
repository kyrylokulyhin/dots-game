# Systemd unit for the Dots Game WebSocket server.
#
# This is a TEMPLATE — placeholders are substituted by infra/scripts/setup-vm.sh.
#
# Placeholders:
#   DOTS_APP_PATH    e.g. /var/www/dots-game
#   DOTS_DEPLOY_USER e.g. deploy
#   DOTS_SERVER_PORT e.g. 3001

[Unit]
Description=Dots Game WebSocket Server
After=network.target
Wants=network.target

[Service]
Type=simple
User=DOTS_DEPLOY_USER
Group=www-data
WorkingDirectory=DOTS_APP_PATH/current/server
ExecStart=DOTS_APP_PATH/current/server/dots-game-server
Restart=always
RestartSec=5
Environment=PORT=DOTS_SERVER_PORT
Environment=BIND_ADDR=127.0.0.1
Environment=DATABASE_URL=DOTS_APP_PATH/shared/data/dots_game.db
Environment=RUST_LOG=dots_game_server=info
StandardOutput=append:/var/log/dots-game-server.log
StandardError=append:/var/log/dots-game-server.log

[Install]
WantedBy=multi-user.target
